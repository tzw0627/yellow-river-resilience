# 复制为 .env 并填入真实值。.env 不会被提交。
# 大模型（OpenAI 兼容协议，DeepSeek / 通义千问 / Moonshot / OpenAI 均可）
LLM_API_KEY=
# 厂商的 OpenAI 兼容 base_url，例如：
#   DeepSeek      https://api.deepseek.com/v1
#   通义千问/百炼  https://dashscope.aliyuncs.com/compatible-mode/v1
#   Moonshot      https://api.moonshot.cn/v1
#   OpenAI        https://api.openai.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1
# 模型名，例如 deepseek-chat / qwen-plus / moonshot-v1-8k / gpt-4o-mini
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# 可选提供商配置：智能体右侧“模型”下拉框会在 GPT 与小米 MiMo 之间切换。
# 未填写 OPENAI_API_KEY 时，openai 选项会继续使用上面的 LLM_* 旧配置。
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Xiaomi MiMo 使用 OpenAI 兼容接口。普通 API Key 可使用下方默认地址；
# Token Plan 用户请将 MIMO_BASE_URL 替换为 Token Plan 页面提供的 OpenAI Base URL。
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# 数据目录（相对 server/ 或绝对路径）。默认指向同级 frontend/data。
DATA_DIR=../frontend/data
# 生产环境下打包后的前端目录（web/dist）。开发时可留空。
WEB_DIST_DIR=

# 允许的前端开发地址
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
